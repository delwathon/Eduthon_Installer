{
    "name": "delwathon/eduthon-installer",
    "description": "Deploys the signed Eduthon school portal onto a school's own web server.",
    "type": "project",
    "license": "proprietary",
    "authors": [
        {
            "name": "Delwathon IT Solutions",
            "email": "dev@delwathon.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-sodium": "*",
        "ext-zip": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload-dev": {
        "psr-4": {
            "Eduthon\\Installer\\": "installer/lib/",
            "Tests\\": "tests/"
        },
        "files": [
            "installer/lib/Support/helpers.php"
        ]
    },
    "scripts": {
        "test": "phpunit",
        "build": "php bin/build",
        "serve": "php bin/serve"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
