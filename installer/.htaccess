# Only index.php and assets/ are reachable over the web.
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(lib|views|storage)(/|$) - [F,L]
    RewriteRule ^(config|config\.local|version|bootstrap)\.php$ - [F,L]
</IfModule>

<FilesMatch "\.(php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>
<Files "index.php">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
</Files>
